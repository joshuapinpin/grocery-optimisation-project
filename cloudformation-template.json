{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation template for BagN(s)ave infrastructure with ALB and ECS Services",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Description": "Select your VPC ID"
    },
    "SubnetOne": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "First Public Subnet ID"
    },
    "SubnetTwo": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Second Public Subnet ID"
    },
    "SecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id",
      "Description": "Your ECS Security Group ID"
    },
    "DBEndpoint": {
      "Type": "String",
      "Description": "RDS PostgreSQL database endpoint"
    },
    "DBUsername": {
      "Type": "String",
      "Description": "Database username"
    },
    "DBPassword": {
      "Type": "String",
      "NoEcho": true,
      "Description": "Database password"
    },
    "ECRBackendImage": {
      "Type": "String",
      "Description": "URI of the ECR backend image"
    },
    "ECRFrontendImage": {
      "Type": "String",
      "Description": "URI of the ECR frontend image"
    }
  },
  "Resources": {
    "ECSCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "bagnsave-cluster"
      }
    },
    "CloudWatchLogsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceRole"
        ]
      }
    },
    "ECSTaskExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ]
      }
    },
    "ApplicationLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "bagnsave-alb",
        "Scheme": "internet-facing",
        "Subnets": [
          {"Ref": "SubnetOne"},
          {"Ref": "SubnetTwo"}
        ],
        "SecurityGroups": [
          {"Ref": "SecurityGroupId"}
        ]
      }
    },
    "ALBListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {"Ref": "ApplicationLoadBalancer"},
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {"Ref": "FrontendTargetGroup"}
          }
        ]
      }
    },
    "BackendTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "bagnsave-backend-tg",
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {"Ref": "VpcId"},
        "HealthCheckPath": "/actuator/health",
        "Matcher": {
          "HttpCode": "200-399"
        }
      }
    },
    "FrontendTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "bagnsave-frontend-tg",
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {"Ref": "VpcId"},
        "HealthCheckPath": "/"
      }
    },
    "ApiListenerRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {"Ref": "ALBListener"},
        "Priority": 10,
        "Conditions": [
          {
            "Field": "path-pattern",
            "Values": ["/api/*"]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {"Ref": "BackendTargetGroup"}
          }
        ]
      }
    },
    "BackendLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/bagnsave-backend",
        "RetentionInDays": 7
      }
    },
    "BackendTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "bagnsave-backend",
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {"Fn::GetAtt": ["ECSTaskExecutionRole", "Arn"]},
        "ContainerDefinitions": [
          {
            "Name": "backend",
            "Image": {"Ref": "ECRBackendImage"},
            "PortMappings": [{"ContainerPort": 8080}],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {"Ref": "BackendLogGroup"},
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "backend"
              }
            },
            "Environment": [
              {
                "Name": "SPRING_DATASOURCE_URL",
                "Value": {"Fn::Sub": "jdbc:postgresql://${DBEndpoint}:5432/bagnsave_db_v2"}
              },
              {
                "Name": "SPRING_DATASOURCE_USERNAME",
                "Value": {"Ref": "DBUsername"}
              },
              {
                "Name": "SPRING_DATASOURCE_PASSWORD",
                "Value": {"Ref": "DBPassword"}
              }
            ]
          }
        ]
      }
    },
    "BackendService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": ["ALBListener", "ApiListenerRule"],
      "Properties": {
        "Cluster": {"Ref": "ECSCluster"},
        "ServiceName": "bagnsave-backend-service",
        "TaskDefinition": {"Ref": "BackendTaskDefinition"},
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [{"Ref": "SubnetOne"}, {"Ref": "SubnetTwo"}],
            "SecurityGroups": [{"Ref": "SecurityGroupId"}]
          }
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {"Ref": "BackendTargetGroup"},
            "ContainerName": "backend",
            "ContainerPort": 8080
          }
        ]
      }
    },
    "FrontendLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/bagnsave-frontend",
        "RetentionInDays": 7
      }
    },
    "FrontendTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "bagnsave-frontend",
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {"Fn::GetAtt": ["ECSTaskExecutionRole", "Arn"]},
        "ContainerDefinitions": [
          {
            "Name": "frontend",
            "Image": {"Ref": "ECRFrontendImage"},
            "PortMappings": [{"ContainerPort": 80}],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {"Ref": "FrontendLogGroup"},
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "frontend"
              }
            }
          }
        ]
      }
    },
    "FrontendService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": ["ALBListener"],
      "Properties": {
        "Cluster": {"Ref": "ECSCluster"},
        "ServiceName": "bagnsave-frontend-service",
        "TaskDefinition": {"Ref": "FrontendTaskDefinition"},
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [{"Ref": "SubnetOne"}, {"Ref": "SubnetTwo"}],
            "SecurityGroups": [{"Ref": "SecurityGroupId"}]
          }
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {"Ref": "FrontendTargetGroup"},
            "ContainerName": "frontend",
            "ContainerPort": 80
          }
        ]
      }
    }
  },
  "Outputs": {
    "LoadBalancerDNS": {
      "Description": "Your permanent application URL",
      "Value": {"Fn::GetAtt": ["ApplicationLoadBalancer", "DNSName"]}
    }
  }
}